DATABASE_URL=sqlite:///./monitor.db
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=server_monitor
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
COLLECTOR_API_KEY=replace-this-with-a-different-random-secret-at-least-32-characters
BOOTSTRAP_TOKEN=replace-this-with-another-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_WINDOW_SECONDS=300
LOGIN_MAX_PER_WINDOW=20
METRICS_RETENTION_DAYS=7
SECURITY_EVENTS_RETENTION_DAYS=30
SCAN_RESULTS_RETENTION_DAYS=30
